---
config:
  theme: dark
  flowchart:
    curve: linear
    nodeSpacing: 50
    rankSpacing: 60
---
flowchart TD
    %% Node Definitions
    START(["🟢 USER INPUT<br/>Pesan User"])
    NLU["🧠 NLU Service<br/>Intent & Coreference"]
    EM["⚡ Event Mapper<br/>Intent to Event"]
    PS["📋 Planner Service<br/>Generate Plan"]
    
    WM{"🔀 Workflow Manager<br/>Dynamic Router Hub"}
    
    INV["📦 Inventory Service<br/>Cek Stok Gudang"]
    PROD["🧪 Production Service<br/>Cek Recipe & Batch"]
    PROC["🛒 Procurement Service<br/>PO & Restock Bahan"]
    PRIC["🏷️ Pricing Service<br/>Cek Harga & Diskon"]
    REP["📊 Reporting Service<br/>Analisis Penjualan"]
    ORD["📝 Order Service<br/>Checkout & Order Baru"]
    
    COORD["🤖 Coordinator AI<br/>LLM Response Synthesis"]
    END_NODE(["🔴 BOT RESPONSE<br/>Jawaban Final"])

    %% 1. Ingestion Pipeline
    subgraph Stage1 ["Tahap 1: Pipeline Analisis & Perencanaan"]
        START --> NLU
        NLU --> EM
        EM --> PS
    end

    PS --> WM

    %% 2. Service Dispatching
    subgraph Stage2 ["Tahap 2: Eksekusi Agen Spesialis"]
        PRIC
        INV
        PROD
        PROC
        REP
        ORD
    end

    WM -->|"1. Cek Harga"| PRIC
    WM -->|"2. Cek Stok"| INV
    WM -->|"3. Produksi"| PROD
    WM -->|"4. Restock Bahan"| PROC
    WM -->|"5. Laporan Business"| REP
    WM -->|"6. Order Baru"| ORD

    %% 3. Return Loops
    PRIC -.->|"Plan Advanced"| WM
    INV -.->|"Plan Advanced"| WM
    PROD -.->|"Plan Advanced"| WM
    PROC -.->|"Plan Advanced"| WM
    REP -.->|"Plan Advanced"| WM
    ORD -.->|"Plan Advanced"| WM

    %% 4. Response Synthesis Pipeline
    subgraph Stage3 ["Tahap 3: Sintesis Respon Akhir"]
        COORD --> END_NODE
    end

    WM ==>|"Plan Selesai"| COORD

    %% Node Styling & Colors
    classDef startEnd fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef intake fill:#1e293b,stroke:#0284c7,stroke-width:2px,color:#e0f2fe;
    classDef router fill:#312e81,stroke:#a5b4fc,stroke-width:3px,color:#ffffff;
    classDef service fill:#064e3b,stroke:#34d399,stroke-width:2px,color:#ecfdf5;
    classDef coord fill:#581c87,stroke:#c084fc,stroke-width:2px,color:#faf5ff;

    class START,END_NODE startEnd;
    class NLU,EM,PS intake;
    class WM router;
    class INV,PROD,PROC,PRIC,REP,ORD service;
    class COORD coord;
