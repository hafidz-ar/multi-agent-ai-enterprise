---
config:
  theme: dark
  flowchart:
    curve: linear
    nodeSpacing: 50
    rankSpacing: 60
---
flowchart TD
    %% Node Definitions
    START(["🟢 USER INPUT<br/>Pesan User"])
    NLU["🧠 NLU Service<br/>Intent & Coreference"]
    EM["⚡ Event Mapper<br/>Intent to Event"]
    PS["📋 Planner Service<br/>Generate Plan"]
    
    WM{"🔀 Workflow Manager<br/>Dynamic Router Hub"}
    
    INV["📦 Inventory Service<br/>Cek Stok Gudang"]
    PROD["🧪 Production Service<br/>Cek Recipe & Batch"]
    PROC["🛒 Procurement Service<br/>PO & Restock Bahan"]
    PRIC["🏷️ Pricing Service<br/>Cek Harga & Diskon"]
    REP["📊 Reporting Service<br/>Analisis Penjualan"]
    ORD["📝 Order Service<br/>Checkout & Order Baru"]
    
    COORD["🤖 Coordinator AI<br/>LLM Response Synthesis"]
    END_NODE(["🔴 BOT RESPONSE<br/>Jawaban Final"])

    %% 1. Ingestion Pipeline
    subgraph Stage1 ["Tahap 1: Pipeline Analisis & Perencanaan"]
        START --> NLU
        NLU --> EM
        EM --> PS
        PS --> WM
    end

    %% 2. Executive Routing (FSM)
    subgraph Stage2 ["Tahap 2: Routing Execution Plan"]
        WM -- "01: Checkout Order" --> ORD
        WM -- "02: Cek Stok Produk" --> INV
        WM -- "03: Cek Harga Katalog" --> PRIC
        WM -- "04: Buat Laporan Penjualan" --> REP
        WM -- "05: Jalankan Produksi" --> PROD
        WM -- "06: Restock/PO Supplier" --> PROC
        WM -- "07: Direct LLM / Clarify" --> COORD
    end

    %% 3. Service Interactions & Cross-Service Dependencies
    subgraph Stage3 ["Tahap 3: Eksekusi Spesialis Service"]
        INV -- "Low/No Stock" --> PROD
        PROD -- "Kurang Bahan Baku" --> PROC
        ORD -- "Update Stok" --> INV
    end

    %% 4. Response Synthesis Pipeline
    subgraph Stage4 ["Tahap 4: Sintesis Respons"]
        INV --> COORD
        PROD --> COORD
        PROC --> COORD
        PRIC --> COORD
        REP --> COORD
        ORD --> COORD
        COORD --> END_NODE
    end

    %% Styling Nodes
    classDef startNode fill:#10B981,stroke:#047857,stroke-width:2px,color:#fff,font-weight:bold;
    classDef endNode fill:#EF4444,stroke:#B91C1C,stroke-width:2px,color:#fff,font-weight:bold;
    classDef router fill:#8B5CF6,stroke:#6D28D9,stroke-width:3px,color:#fff,font-weight:bold;
    classDef service fill:#1E293B,stroke:#3B82F6,stroke-width:2px,color:#93C5FD;
    classDef llm fill:#F59E0B,stroke:#D97706,stroke-width:2px,color:#FFFBEB,font-weight:bold;
    classDef ingester fill:#334155,stroke:#64748B,stroke-width:1px,color:#F8FAFC;

    class START startNode;
    class END_NODE endNode;
    class WM router;
    class NLU,EM,PS ingester;
    class INV,PROD,PROC,PRIC,REP,ORD service;
    class COORD llm;
